rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자: 서버(auth-proxy 서비스계정)만
    match /admins/{id}             { allow read, write: if false; }

    // 회원: 클라이언트 직접 접근 전면 차단 (조회/생성/수정/삭제 모두 서버 경유)
    match /users/{id}              { allow read, write: if false; }

    // 신청: 클라이언트 직접 접근 전면 차단 (모두 서버 경유)
    match /applications/{id}       { allow read, write: if false; }

    // 사이트 콘텐츠/전문가/알림: 현행 유지(민감도 낮음, 후속 정리)
    match /siteContents/{id}       { allow read, write: if true; }
    match /experts/{id}            { allow read, write: if true; }
    match /adminNotifications/{id} { allow read, write: if true; }

    match /{document=**} { allow read, write: if false; }
  }
}
